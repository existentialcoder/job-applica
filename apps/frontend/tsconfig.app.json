{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "./src/**/*",
    "./src/**/*.vue",
    "./src/**/*.ts",
    "./src/**/*.d.ts",
    "./src/**/**/*.ts",
    "./src/**/**/*.d.ts",
    "../../packages/ui/src/**/*"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/components/ui/*": ["../../packages/ui/src/components/ui/*"],
      "@job-applica/ui/*": ["../../packages/ui/src/*"],
      "@/*": ["./src/*"]
    }
  }
}
