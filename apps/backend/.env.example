# Copy to .env. Only the first three are required; everything else in src/core/config.py has a local default.
APP_ENV=local
DATABASE_URL=postgresql://postgres:password@localhost:5432/job_applica
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Google sign-in, Gmail and Calendar
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI features (ATS scoring, extraction) — the default LLM_CONFIG uses DeepSeek
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
